<?xml version="1.0" encoding="UTF-8"?>
<component type="addon">
  <id>org.freedesktop.LinuxAudio.Plugins.NeuralAmpModeler</id>
  <name>Neural Amp Modeler</name>
  <summary>Neural Amp Modeler LV2 plugin</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <extends>org.freedesktop.LinuxAudio.BaseExtension</extends>
  <description>
    <p>
      Neural network emulator for guitar amplifiers. LV2 plugin.
    </p>
  </description>
  <url type="vcs-browser">https://github.com/mikeoliphant/neural-amp-modeler-lv2</url>
  <url type="bugtracker">https://github.com/mikeoliphant/neural-amp-modeler-lv2/issues</url>
  <url type="homepage">https://github.com/sdatkinson/neural-amp-modeler</url>
  <releases>
    <release version="0.2.2" date="2026-07-08">
      <url>https://github.com/mikeoliphant/neural-amp-modeler-lv2/releases/tag/v0.2.2</url>
      <description>
        <ul>
          <li>Internal NeuralAudio support for NAM A2 models</li>
          <li>Use gcc15 for Linux builds</li>
          <li>Use static glibc for more portable Linux builds</li>
        </ul>
      </description>
    </release>
    <release version="0.2.1" date="2026-06-26">
      <url>https://github.com/mikeoliphant/neural-amp-modeler-lv2/releases/tag/v0.2.1</url>
      <description>
        <ul>
          <li>Added oversampling support</li>
          <li>Fixed smart bypass on NAM A2 models</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-06-02">
      <url>https://github.com/mikeoliphant/neural-amp-modeler-lv2/releases/tag/v0.2.0</url>
      <description>
        <ul>
          <li>NAM A2 model support with quality scaling</li>
          <li>Optional (compile-time) support for smart bypass on silence</li>
        </ul>
      </description>
    </release>
    <release version="0.1.9" date="2025-06-09">
      <url>https://github.com/mikeoliphant/neural-amp-modeler-lv2/releases/tag/v0.1.9</url>
      <description>
        <ul>
          <li>Fixed a regression that was causing sample rate to be fixed at 48k for NAM files</li>
        </ul>
      </description>
    </release>
    <release version="0.1.8" date="2025-05-27">
      <url>https://github.com/mikeoliphant/neural-amp-modeler-lv2/releases/tag/v0.1.8</url>
      <description>
        <ul>
          <li>Very fast pre-warm for WaveNet models</li>
          <li>Fixed some issues loading non-static LSTM models</li>
          <li>Fixed some issues loading certain Aida-X models</li>
          <li>Fixed an issue loading large non-standard WaveNet models (ie: "hyper" accuracy)</li>
        </ul>
      </description>
    </release>
    <release version="0.1.7" date="2025-02-13">
      <url>https://github.com/mikeoliphant/neural-amp-modeler-lv2/releases/tag/v0.1.7</url>
      <description>
        <ul>
          <li>New NeuralAudio WaveNet and LSTM implementation with significantly increased performance</li>
        </ul>
      </description>
    </release>
    <release version="0.1.6" date="2024-12-02">
      <url>https://github.com/mikeoliphant/neural-amp-modeler-lv2/releases/tag/0.1.6</url>
      <description>
        <ul>
          <li>Added input calibration for models that support it</li>
          <li>Improved RTNeural WaveNet performance</li>
          <li>Added ".aidax" file extention</li>
        </ul>
      </description>
    </release>
    <release version="0.1.5" date="2024-11-04">
      <url>https://github.com/mikeoliphant/neural-amp-modeler-lv2/releases/tag/0.1.5</url>
      <description>
        <ul>
          <li>Use RTNeural for NAM LSTM models (approx. 2x performance increase)</li>
          <li>Added support for RTNeural keras json models (ie: Aida-X models)</li>
          <li>Updated to latest NAM core</li>
          <li>Removed dc blocker</li>
        </ul>
      </description>
    </release>
    <release version="0.1.4" date="2024-08-17">
      <url>https://github.com/mikeoliphant/neural-amp-modeler-lv2/releases/tag/0.1.4</url>
      <description>
        <ul>
          <li>Sync to latest NeuralAmpModelerCore (fixes WaveNet head check on some systems)</li>
          <li>Make dc blocker sample rate dependent</li>
          <li>x64 optimizations are now off by default</li>
        </ul>
      </description>
    </release>
    <release version="0.1.3" date="2023-10-16">
      <url>https://github.com/mikeoliphant/neural-amp-modeler-lv2/releases/tag/0.1.3</url>
      <description>
        <ul>
          <li>Simplified NAM processing loop</li>
          <li>Handle model loudness normalization in plugin</li>
        </ul>
      </description>
    </release>
    <release version="0.1.2" date="2023-09-13">
      <url>https://github.com/mikeoliphant/neural-amp-modeler-lv2/releases/tag/0.1.2</url>
      <description>
        <ul>
          <li>Added 5Hz high pass filter to clean up any DC offset created by the model.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.1" date="2023-07-07">
      <url>https://github.com/mikeoliphant/neural-amp-modeler-lv2/releases/tag/0.1.1</url>
      <description>
        <ul>
          <li>Fixed model display after preset loading.</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2023-06-21">
      <url>https://github.com/mikeoliphant/neural-amp-modeler-lv2/releases/tag/0.1.0</url>
      <description>
        <p>
          Initial release.
        </p>
      </description>
    </release>
  </releases>
</component>
